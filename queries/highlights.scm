; Field-specific captures preserve contextual identifiers and unknown tags.
((comment) @comment @spell (#set! priority 110))
((string) @string (#set! priority 110))
((interpolated_string "\"" @string) (#set! priority 110))
((interpolated_string (string_fragment) @string) (#set! priority 110))
((string_interpolation ["{" "}" "`"] @punctuation.special) (#set! priority 110))
((variable) @variable (#set! priority 110))
((config_variable name: (identifier) @constant) (#set! priority 110))
((config_variable "#" @punctuation.special) (#set! priority 110))
((number) @number (#set! priority 110))
((boolean) @boolean (#set! priority 110))
((null) @constant.builtin (#set! priority 110))
((custom_tag name: (identifier) @tag) (#set! priority 110))
((custom_close_tag name: (identifier) @tag) (#set! priority 110))
((attribute name: [(identifier) (tag_attribute_name)] @tag.attribute) (#set! priority 110))
((member_expression member: (identifier) @variable.member) (#set! priority 110))
((loop_metadata_expression property: (identifier) @variable.member) (#set! priority 110))
((index_expression index: (identifier) @variable.member) (#set! priority 110))
((section_property_expression section: (identifier) @variable.member property: (identifier) @variable.member) (#set! priority 110))
((section_property_index section: (identifier) @variable.member property: (identifier) @variable.member) (#set! priority 110))
((section_index name: (identifier) @variable.member) (#set! priority 110))
((function_call_expression name: (identifier) @function.call) (#set! priority 110))
((modifier_expression name: (identifier) @function.call) (#set! priority 110))
((method_call_expression method: (identifier) @function.method.call) (#set! priority 110))
((static_method_call_expression class: (identifier) @type method: (identifier) @function.method.call) (#set! priority 110))
((class_constant_expression class: (identifier) @type constant: (identifier) @constant) (#set! priority 110))
((binary_expression operator: _ @operator) (#set! priority 110))
((unary_expression operator: _ @operator) (#set! priority 110))
((single_condition_expression operator: _ @keyword.operator) (#set! priority 110))
((typecast_operator) @type.builtin (#set! priority 110))
((word_operator) @keyword.operator (#set! priority 110))
((div_by_operator) @keyword.operator (#set! priority 110))
((parity_by_operator) @keyword.operator (#set! priority 110))
(["if" "elseif" "else"] @keyword.conditional (#set! priority 110))
(["foreach" "foreachelse" "for" "forelse" "section" "sectionelse" "as" "to" "step"] @keyword.repeat (#set! priority 110))
(["=" "=>" "->" "::" "|" "?"] @operator (#set! priority 110))
(["(" ")" "[" "]"] @punctuation.bracket (#set! priority 110))
(["," "." ":"] @punctuation.delimiter (#set! priority 110))
; Nested script/style captures can span Smarty holes in Neovim 0.11.
; Keep Smarty above the host languages (default priority 100).
(["{" "}" "{/"] @tag.delimiter (#set! priority 110))
((literal_tag) @keyword (#set! priority 110))
((literal_close_tag) @keyword (#set! priority 110))
