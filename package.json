{
  "name": "tree-sitter-smarty2",
  "version": "0.1.0",
  "description": "Smarty2 grammar for tree-sitter",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tree-sitter/tree-sitter-smarty2.git"
  },
  "funding": "",
  "license": "MIT",
  "author": {
    "name": "roguecat0",
    "email": "roguecat0@gmail.com",
    "url": ""
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "smarty2"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/**",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.9",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "check:grammar": "tsc --noEmit --allowJs --checkJs --target ES2022 grammar.js",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "pretest": "tree-sitter generate && node-gyp rebuild",
    "test": "npm run check:grammar && node test/run.mjs",
    "precorpus:report": "tree-sitter generate && node-gyp rebuild",
    "corpus:report": "node scripts/corpus-report.mjs"
  }
}
